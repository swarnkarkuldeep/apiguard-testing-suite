# MySQL root password (dev only)
MYSQL_ROOT_PASSWORD=change-me-root
# JWT signing secrets, one per environment (dev only, use any long random string)
JWT_SECRET_LOCAL=change-me-local-secret
JWT_SECRET_STAGING=change-me-staging-secret
# Seeded test accounts (dev only). Passwords match the bcrypt hashes in db/seed-*.sql
# local   admin: admin@iguard.local   / Admin#Local123    user: user@iguard.local   / User#Local123
# staging admin: admin@iguard.staging / Admin#Stage456    user: user@iguard.staging / User#Stage456
