{
  "info": {
    "_postman_id": "iguard-collection-0001",
    "name": "IGuard API Tests",
    "description": "Tests for the IGuard store API. Run with an environment (local or staging) selected. Folders run in order: Health, Auth, Products CRUD, Orders, Negative, Cleanup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "contentType",
      "value": "application/json"
    },
    {
      "key": "maxResponseMs",
      "value": "1000"
    },
    {
      "key": "schema_health",
      "value": "{\"type\":\"object\",\"required\":[\"status\",\"env\"],\"properties\":{\"status\":{\"enum\":[\"ok\"]},\"env\":{\"type\":\"string\"}},\"additionalProperties\":false}"
    },
    {
      "key": "schema_user",
      "value": "{\"type\":\"object\",\"required\":[\"id\",\"name\",\"email\",\"role\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"email\":{\"type\":\"string\"},\"role\":{\"enum\":[\"user\",\"admin\"]}},\"additionalProperties\":false}"
    },
    {
      "key": "schema_login",
      "value": "{\"type\":\"object\",\"required\":[\"token\"],\"properties\":{\"token\":{\"type\":\"string\"}},\"additionalProperties\":false}"
    },
    {
      "key": "schema_product",
      "value": "{\"type\":\"object\",\"required\":[\"id\",\"name\",\"sku\",\"price\",\"stock\",\"created_at\",\"updated_at\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"sku\":{\"type\":\"string\"},\"price\":{\"type\":\"number\",\"minimum\":0},\"stock\":{\"type\":\"integer\",\"minimum\":0},\"created_at\":{\"type\":\"string\"},\"updated_at\":{\"type\":\"string\"}},\"additionalProperties\":false}"
    },
    {
      "key": "schema_productList",
      "value": "{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"id\",\"name\",\"sku\",\"price\",\"stock\",\"created_at\",\"updated_at\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"name\":{\"type\":\"string\"},\"sku\":{\"type\":\"string\"},\"price\":{\"type\":\"number\",\"minimum\":0},\"stock\":{\"type\":\"integer\",\"minimum\":0},\"created_at\":{\"type\":\"string\"},\"updated_at\":{\"type\":\"string\"}},\"additionalProperties\":false}}"
    },
    {
      "key": "schema_order",
      "value": "{\"type\":\"object\",\"required\":[\"id\",\"total\",\"items\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"total\":{\"type\":\"number\",\"minimum\":0},\"items\":{\"type\":\"array\",\"minItems\":1,\"items\":{\"type\":\"object\",\"required\":[\"productId\",\"qty\",\"unitPrice\"],\"properties\":{\"productId\":{\"type\":\"integer\"},\"qty\":{\"type\":\"integer\",\"minimum\":1},\"unitPrice\":{\"type\":\"number\",\"minimum\":0}},\"additionalProperties\":false}}},\"additionalProperties\":false}"
    },
    {
      "key": "schema_orderDetail",
      "value": "{\"type\":\"object\",\"required\":[\"id\",\"userId\",\"total\",\"createdAt\",\"items\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"userId\":{\"type\":\"integer\"},\"total\":{\"type\":\"number\",\"minimum\":0},\"createdAt\":{\"type\":\"string\"},\"items\":{\"type\":\"array\",\"minItems\":1,\"items\":{\"type\":\"object\",\"required\":[\"productId\",\"qty\",\"unitPrice\"],\"properties\":{\"productId\":{\"type\":\"integer\"},\"qty\":{\"type\":\"integer\",\"minimum\":1},\"unitPrice\":{\"type\":\"number\",\"minimum\":0}},\"additionalProperties\":false}}},\"additionalProperties\":false}"
    },
    {
      "key": "schema_orderList",
      "value": "{\"type\":\"array\",\"items\":{\"type\":\"object\",\"required\":[\"id\",\"total\",\"createdAt\"],\"properties\":{\"id\":{\"type\":\"integer\"},\"total\":{\"type\":\"number\",\"minimum\":0},\"createdAt\":{\"type\":\"string\"}},\"additionalProperties\":false}}"
    },
    {
      "key": "schema_error",
      "value": "{\"type\":\"object\",\"required\":[\"error\"],\"properties\":{\"error\":{\"type\":\"object\",\"required\":[\"code\",\"message\"],\"properties\":{\"code\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}},\"additionalProperties\":false}},\"additionalProperties\":false}"
    }
  ],
  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The API reports which environment it is running as; it must match the selected Postman environment.",
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('status is ok', () => pm.expect(json.status).to.eql('ok'));",
                  "pm.test('API env matches Postman environment', () => pm.expect(json.env).to.eql(pm.environment.get('envName')));",
                  "// JSON schema check (tv4). schema_health is defined as a collection variable.",
                  "pm.test('response matches schema_health', () => {",
                  "  const schema = JSON.parse(pm.variables.get('schema_health'));",
                  "  pm.expect(tv4.validate(pm.response.json(), schema), JSON.stringify(tv4.error)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Register new user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{contentType}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Tester\",\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{newUserPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique email per run so the collection can be re-run against the same database.",
                  "pm.environment.set('newUserEmail', 'qa_' + Date.now() + '@example.com');",
                  "pm.environment.set('newUserPassword', 'Passw0rd!QA');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('returns the new user with role \"user\"', () => {",
                  "  pm.expect(json.email).to.eql(pm.environment.get('newUserEmail'));",
                  "  pm.expect(json.role).to.eql('user');",
                  "});",
                  "pm.test('password is never returned', () => pm.expect(json).to.not.have.property('password'));",
                  "// Chain: later requests and SQL checks use this id.",
                  "pm.environment.set('newUserId', json.id);",
                  "// JSON schema check (tv4). schema_user is defined as a collection variable.",
                  "pm.test('response matches schema_user', () => {",
                  "  const schema = JSON.parse(pm.variables.get('schema_user'));",
                  "  pm.expect(tv4.validate(pm.response.json(), schema), JSON.stringify(tv4.error)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login new user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{contentType}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{newUserPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('returns a JWT', () => pm.expect(json.token).to.be.a('string').and.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/));",
                  "// Chain: the orders folder sends this as its Bearer token.",
                  "pm.environment.set('userToken', json.token);",
                  "// JSON schema check (tv4). schema_login is defined as a collection variable.",
                  "pm.test('response matches schema_login', () => {",
                  "  const schema = JSON.parse(pm.variables.get('schema_login'));",
                  "  pm.expect(tv4.validate(pm.response.json(), schema), JSON.stringify(tv4.error)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{contentType}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('returns a JWT', () => pm.expect(json.token).to.be.a('string'));",
                  "// Chain: the products folder sends this as its Bearer token.",
                  "pm.environment.set('adminToken', json.token);",
                  "// JSON schema check (tv4). schema_login is defined as a collection variable.",
                  "pm.test('response matches schema_login', () => {",
                  "  const schema = JSON.parse(pm.variables.get('schema_login'));",
                  "  pm.expect(tv4.validate(pm.response.json(), schema), JSON.stringify(tv4.error)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Products CRUD",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Create product (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{contentType}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{productName}}\",\n  \"sku\": \"{{productSku}}\",\n  \"price\": {{productPrice}},\n  \"stock\": {{productStock}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Test data generated on every run, so the collection can be re-run against the same database.",
                  "// {{$randomProductName}} is a Postman dynamic variable; replaceIn() resolves it inside a script.",
                  "pm.environment.set('productSku', 'QA-' + Date.now());              // sku is UNIQUE in the database",
                  "pm.environment.set('productName', 'QA ' + pm.variables.replaceIn('{{$randomProductName}}'));",
                  "pm.environment.set('productPrice', Number((Math.random() * 90 + 10).toFixed(2)));",
                  "pm.environment.set('productStock', 20 + Math.floor(Math.random() * 80));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('product has the values we sent', () => {",
                  "  pm.expect(json.name).to.eql(pm.environment.get('productName'));",
                  "  pm.expect(json.sku).to.eql(pm.environment.get('productSku'));",
                  "  pm.expect(json.price).to.eql(Number(pm.environment.get('productPrice')));",
                  "  pm.expect(json.stock).to.eql(Number(pm.environment.get('productStock')));",
                  "});",
                  "// Chain: read, update and order requests use this id.",
                  "pm.environment.set('productId', json.id);",
                  "// JSON schema check (tv4). schema_product is defined as a collection variable.",
                  "pm.test('response matches schema_product', () => {",
                  "  const schema = JSON.parse(pm.variables.get('schema_product'));",
                  "  pm.expect(tv4.validate(pm.response.json(), schema), JSON.stringify(tv4.error)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('returns the product we created', () => {",
                  "  pm.expect(json.id).to.eql(Number(pm.environment.get('productId')));",
                  "  pm.expect(json.name).to.eql(pm.environment.get('productName'));",
                  "  pm.expect(json.sku).to.eql(pm.environment.get('productSku'));",
                  "});",
                  "// JSON schema check (tv4). schema_product is defined as a collection variable.",
                  "pm.test('response matches schema_product', () => {",
                  "  const schema = JSON.parse(pm.variables.get('schema_product'));",
                  "  pm.expect(tv4.validate(pm.response.json(), schema), JSON.stringify(tv4.error)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('returns an array that includes the product we created', () => {",
                  "  pm.expect(json).to.be.an('array');",
                  "  const ids = json.map((p) => p.id);",
                  "  pm.expect(ids).to.include(Number(pm.environment.get('productId')));",
                  "});",
                  "pm.test('seed products are still present', () => pm.expect(json.length).to.be.at.least(5));",
                  "// JSON schema check (tv4). schema_productList is defined as a collection variable.",
                  "pm.test('response matches schema_productList', () => {",
                  "  const schema = JSON.parse(pm.variables.get('schema_productList'));",
                  "  pm.expect(tv4.validate(pm.response.json(), schema), JSON.stringify(tv4.error)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update product (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{contentType}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{updatedName}}\",\n  \"sku\": \"{{productSku}}\",\n  \"price\": {{updatedPrice}},\n  \"stock\": {{updatedStock}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('response shows the updated values', () => {",
                  "  pm.expect(json.id).to.eql(Number(pm.environment.get('productId')));",
                  "  pm.expect(json.name).to.eql(pm.environment.get('updatedName'));",
                  "  pm.expect(json.price).to.eql(Number(pm.environment.get('updatedPrice')));",
                  "  pm.expect(json.stock).to.eql(Number(pm.environment.get('updatedStock')));",
                  "});",
                  "// JSON schema check (tv4). schema_product is defined as a collection variable.",
                  "pm.test('response matches schema_product', () => {",
                  "  const schema = JSON.parse(pm.variables.get('schema_product'));",
                  "  pm.expect(tv4.validate(pm.response.json(), schema), JSON.stringify(tv4.error)).to.be.true;",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate the \"after\" values; the order request later checks its total against updatedPrice.",
                  "pm.environment.set('updatedName', pm.environment.get('productName') + ' v2');",
                  "pm.environment.set('updatedPrice', Number((Math.random() * 90 + 10).toFixed(2)));",
                  "pm.environment.set('updatedStock', 20 + Math.floor(Math.random() * 80));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create temporary product (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{contentType}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Temp Item\",\n  \"sku\": \"{{tempSku}}\",\n  \"price\": 1.5,\n  \"stock\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('tempSku', 'QA-TMP-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 201', () => pm.response.to.have.status(201));",
                  "// Chain: this product exists only to be deleted below.",
                  "pm.environment.set('tempProductId', pm.response.json().id);",
                  "// JSON schema check (tv4). schema_product is defined as a collection variable.",
                  "pm.test('response matches schema_product', () => {",
                  "  const schema = JSON.parse(pm.variables.get('schema_product'));",
                  "  pm.expect(tv4.validate(pm.response.json(), schema), JSON.stringify(tv4.error)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete temporary product (admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{tempProductId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{tempProductId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 204', () => pm.response.to.have.status(204));",
                  "pm.test('no response body', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get deleted product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{tempProductId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{tempProductId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 404 after delete', () => pm.response.to.have.status(404));",
                  "pm.test('error code is NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));",
                  "// JSON schema check (tv4). schema_error is defined as a collection variable.",
                  "pm.test('response matches schema_error', () => {",
                  "  const schema = JSON.parse(pm.variables.get('schema_error'));",
                  "  pm.expect(tv4.validate(pm.response.json(), schema), JSON.stringify(tv4.error)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Orders",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{userToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Create order (user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{contentType}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": {{productId}}, \"qty\": 2 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "// Product price was changed by the update request, so the order must use updatedPrice.",
                  "const price = Number(pm.environment.get('updatedPrice'));",
                  "const expectedTotal = Math.round(price * 2 * 100) / 100;",
                  "pm.test('total is computed from the current price', () => {",
                  "  pm.expect(json.total).to.eql(expectedTotal);",
                  "  pm.expect(json.items[0].unitPrice).to.eql(price);",
                  "  pm.expect(json.items[0].qty).to.eql(2);",
                  "});",
                  "// Chain: get-order, list-orders and SQL checks use this id.",
                  "pm.environment.set('orderId', json.id);",
                  "// JSON schema check (tv4). schema_order is defined as a collection variable.",
                  "pm.test('response matches schema_order', () => {",
                  "  const schema = JSON.parse(pm.variables.get('schema_order'));",
                  "  pm.expect(tv4.validate(pm.response.json(), schema), JSON.stringify(tv4.error)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('order belongs to the new user and has our product', () => {",
                  "  pm.expect(json.id).to.eql(Number(pm.environment.get('orderId')));",
                  "  pm.expect(json.userId).to.eql(Number(pm.environment.get('newUserId')));",
                  "  pm.expect(json.items[0].productId).to.eql(Number(pm.environment.get('productId')));",
                  "});",
                  "// JSON schema check (tv4). schema_orderDetail is defined as a collection variable.",
                  "pm.test('response matches schema_orderDetail', () => {",
                  "  const schema = JSON.parse(pm.variables.get('schema_orderDetail'));",
                  "  pm.expect(tv4.validate(pm.response.json(), schema), JSON.stringify(tv4.error)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
