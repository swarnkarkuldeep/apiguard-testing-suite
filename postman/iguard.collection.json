  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs after every request in the collection.",
          "// pm.variables.get() is used (not collectionVariables) so Newman can override values with --env-var.",
          "const maxMs = Number(pm.variables.get('maxResponseMs'));",
          "pm.test('response time < ' + maxMs + ' ms', () => pm.expect(pm.response.responseTime).to.be.below(maxMs));",
          "if (pm.response.code !== 204) {",
          "  pm.test('Content-Type is application/json', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/application\\/json/));",
          "}"
        ]
      }
    }
