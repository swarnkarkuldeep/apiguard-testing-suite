{
  "info": {
    "_postman_id": "iguard-collection-0001",
    "name": "IGuard API Tests",
    "description": "Tests for the IGuard store API. Run with an environment (local or staging) selected. Folders run in order: Health, Auth, Products CRUD, Orders, Negative, Cleanup.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "contentType",
      "value": "application/json"
    },
    {
      "key": "maxResponseMs",
      "value": "1000"
    }
  ],
  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The API reports which environment it is running as; it must match the selected Postman environment.",
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('status is ok', () => pm.expect(json.status).to.eql('ok'));",
                  "pm.test('API env matches Postman environment', () => pm.expect(json.env).to.eql(pm.environment.get('envName')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Register new user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{contentType}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Tester\",\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{newUserPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique email per run so the collection can be re-run against the same database.",
                  "pm.environment.set('newUserEmail', 'qa_' + Date.now() + '@example.com');",
                  "pm.environment.set('newUserPassword', 'Passw0rd!QA');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('returns the new user with role \"user\"', () => {",
                  "  pm.expect(json.email).to.eql(pm.environment.get('newUserEmail'));",
                  "  pm.expect(json.role).to.eql('user');",
                  "});",
                  "pm.test('password is never returned', () => pm.expect(json).to.not.have.property('password'));",
                  "// Chain: later requests and SQL checks use this id.",
                  "pm.environment.set('newUserId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login new user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{contentType}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{newUserEmail}}\",\n  \"password\": \"{{newUserPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('returns a JWT', () => pm.expect(json.token).to.be.a('string').and.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/));",
                  "// Chain: the orders folder sends this as its Bearer token.",
                  "pm.environment.set('userToken', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{contentType}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('returns a JWT', () => pm.expect(json.token).to.be.a('string'));",
                  "// Chain: the products folder sends this as its Bearer token.",
                  "pm.environment.set('adminToken', json.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Products CRUD",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{adminToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Create product (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{contentType}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Widget\",\n  \"sku\": \"{{productSku}}\",\n  \"price\": 19.99,\n  \"stock\": 50\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique SKU per run (sku is UNIQUE in the database).",
                  "pm.environment.set('productSku', 'QA-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('product has the values we sent', () => {",
                  "  pm.expect(json.name).to.eql('QA Widget');",
                  "  pm.expect(json.sku).to.eql(pm.environment.get('productSku'));",
                  "  pm.expect(json.price).to.eql(19.99);",
                  "  pm.expect(json.stock).to.eql(50);",
                  "});",
                  "// Chain: read, update and order requests use this id.",
                  "pm.environment.set('productId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('returns the product we created', () => {",
                  "  pm.expect(json.id).to.eql(Number(pm.environment.get('productId')));",
                  "  pm.expect(json.sku).to.eql(pm.environment.get('productSku'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update product (admin)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{contentType}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{productId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Widget v2\",\n  \"sku\": \"{{productSku}}\",\n  \"price\": 24.5,\n  \"stock\": 75\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('response shows the updated values', () => {",
                  "  pm.expect(json.name).to.eql('QA Widget v2');",
                  "  pm.expect(json.price).to.eql(24.5);",
                  "  pm.expect(json.stock).to.eql(75);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create temporary product (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{contentType}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Temp Item\",\n  \"sku\": \"{{tempSku}}\",\n  \"price\": 1.5,\n  \"stock\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('tempSku', 'QA-TMP-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 201', () => pm.response.to.have.status(201));",
                  "// Chain: this product exists only to be deleted below.",
                  "pm.environment.set('tempProductId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete temporary product (admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{tempProductId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{tempProductId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 204', () => pm.response.to.have.status(204));",
                  "pm.test('no response body', () => pm.expect(pm.response.text()).to.eql(''));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get deleted product",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{tempProductId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "{{tempProductId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 404 after delete', () => pm.response.to.have.status(404));",
                  "pm.test('error code is NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Orders",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{userToken}}",
            "type": "string"
          }
        ]
      },
      "item": [
        {
          "name": "Create order (user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "{{contentType}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": {{productId}}, \"qty\": 2 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "// The product was updated to price 24.5 earlier in the run, so 2 x 24.5 = 49.",
                  "pm.test('total is computed from the current price', () => {",
                  "  pm.expect(json.total).to.eql(49);",
                  "  pm.expect(json.items[0].unitPrice).to.eql(24.5);",
                  "});",
                  "// Chain: get-order request and SQL checks use this id.",
                  "pm.environment.set('orderId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get order",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders",
                "{{orderId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('order belongs to the new user and has our product', () => {",
                  "  pm.expect(json.id).to.eql(Number(pm.environment.get('orderId')));",
                  "  pm.expect(json.userId).to.eql(Number(pm.environment.get('newUserId')));",
                  "  pm.expect(json.items[0].productId).to.eql(Number(pm.environment.get('productId')));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Negative",
      "item": []
    },
    {
      "name": "99 Cleanup",
      "item": []
    }
  ]
}
